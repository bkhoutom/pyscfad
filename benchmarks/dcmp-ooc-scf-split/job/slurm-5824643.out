#INFO: **** input file is /resnick/home/bkhou/DLNO_CCSDT/test_pyscfad_stc_mp2/runtime_test/dCMP-ooc/test_reverse/scf_df_split/driver.py ****
"""dCMP energy/gradient with disk-backed AO DF and phase-local SciPy threads."""
import json
import math
import hashlib
import socket
import resource
from pathlib import Path
from pyscfad.lib._threading import dense_blas_threads

import os
import sys
import time
import jax
import pyscf
import pyscfad
import pyscfadlib
from pyscfad import config, gto, scf
from pyscfad.mp import dfmp2
from jaxlib.cpu import _lapack
from threadpoolctl import ThreadpoolController, threadpool_info
import timing_ledger as ledger

ledger.install()

print(f'Python: {sys.executable}', flush=True)
print(f'PySCFAD {pyscfad.__version__}: {pyscfad.__file__}', flush=True)
print(f'PySCFADlib {pyscfadlib.__version__}: {pyscfadlib.__file__}', flush=True)
print(f'PySCF {pyscf.__version__}: {pyscf.__file__}', flush=True)
print(f'JAX {jax.__version__}; x64={jax.config.x64_enabled}; '
      f'OpenMP threads={pyscf.lib.num_threads()}', flush=True)

MAX_MEMORY = 120000  # MB, advisory budget
FROZEN = 24
MODE = os.environ['BENCH_MODE']
CASE = os.environ['BENCH_CASE']
assert MODE in ('incore', 'outcore')
print(f'Benchmark case: {CASE}; mode={MODE}', flush=True)
CDERI_PATH = os.path.join(os.environ['PYSCF_TMPDIR'], 'dcmp-cderi.h5')
DF_THREADS = int(os.environ.get(
    'SCIPY_DF_THREADS', os.environ.get('SLURM_CPUS_PER_TASK', '1')))
if DF_THREADS < 1:
    raise ValueError('SCIPY_DF_THREADS must be positive')

config.update('pyscfad_moleintor_opt', True)
config.update('pyscfad_scf_implicit_diff', True)
config.update('pyscfad_scf_df_precond', True)

ATOM = 'input.xyz'

mol = gto.Mole()
mol.atom = ATOM
mol.basis = 'cc-pvtz'
mol.verbose = 4
mol.max_memory = MAX_MEMORY
mol.build(trace_exp=False, trace_ctr_coeff=False)

# Initialize before selecting the exact SciPy library used by JAX CPU LAPACK.
_lapack.initialize()
controller = ThreadpoolController()
scipy_paths = [pool['filepath'] for pool in controller.info()
               if pool['user_api'] == 'blas' and '/scipy.libs/' in pool['filepath']]
assert len(scipy_paths) == 1, scipy_paths
scipy_pool = controller.select(filepath=scipy_paths)
phase_threadpools = {}


def record_threads(phase, scipy_threads):
    pools = threadpool_info()
    for pool in pools:
        if pool['user_api'] == 'blas':
            expected = scipy_threads if pool['filepath'] in scipy_paths else 1
            assert pool['num_threads'] == expected, (phase, pool, expected)
    phase_threadpools[phase] = pools
    print(f'{phase}: SciPy BLAS threads={scipy_threads}; other BLAS threads=1',
          flush=True)


def df_state(mol):
    mf = scf.RHF(mol).density_fit(auxbasis='cc-pvtz-jkfit')
    if MODE == 'incore':
        mf.with_df.build()
    else:
        mf.with_df.incore = False
        # Attach inside the trace: custom VJPs retain AO and auxiliary response.
        mf.with_df.attach_outcore_cderi(CDERI_PATH)
    return mol, mf.with_df


def scf_state(df_inputs):
    mol, with_df = df_inputs
    assert (with_df._has_outcore_cderi_placeholder() if MODE == 'outcore'
            else with_df._cderi is not None)
    mf = scf.RHF(mol).density_fit(with_df=with_df)
    mf.conv_tol, mf.conv_tol_grad, mf.max_cycle = 1e-10, 1e-8, 250
    mf.kernel()
    # Keep every molecular/DF path and explicit HF energy in the output pytree.
    return (mf.mol, mf.with_df, mf.e_tot, mf.mo_coeff, mf.mo_energy), mf.converged


def mp2_energy(state):
    mol, with_df, ehf, mo_coeff, mo_energy = state
    mf = scf.RHF(mol).density_fit(with_df=with_df)
    mf.e_tot, mf.mo_coeff, mf.mo_energy = ehf, mo_coeff, mo_energy
    mf.mo_occ = mf.get_occ()
    mf.converged = True
    mp = dfmp2.MP2(mf, frozen=FROZEN)
    mp.kernel(with_t2=False)
    return mp.e_tot


# Record effective pools once, outside the timed calculation.
with dense_blas_threads():
    dense_pools = threadpool_info()
settings = {name: os.environ.get(name) for name in (
    'OMP_NUM_THREADS', 'SCIPY_DF_THREADS', 'PYSCFAD_DENSE_BLAS_THREADS',
    'PYSCFAD_FACTOR_PANEL_MEMORY_MB', 'PYSCFAD_SOLVE_MEMORY_MB',
    'PYSCFAD_PRECOND_CACHE_MEMORY_MB')}
print('Tuning settings:', json.dumps(settings), flush=True)
print('Effective scoped BLAS pools:', json.dumps(dense_pools), flush=True)
source_hashes = {}
for rel in ('df/df.py', 'df/_df_jk_factorized.py', 'df/_df_jk_opt.py',
            'df/_cderi_vjp.py', 'df/_int3c_cross_opt.py', 'mp/dfmp2.py',
            'scf/hf.py', '_src/implicit_diff.py', 'lib/_threading.py'):
    path = Path(pyscfad.__file__).parent / rel
    source_hashes[rel] = hashlib.sha256(path.read_bytes()).hexdigest()

phase_seconds = {}
t0 = time.perf_counter()
with scipy_pool.limit(limits=DF_THREADS), ledger.phase('df_forward'):
    record_threads('df_forward', DF_THREADS)
    start = time.perf_counter()
    # Build once for this geometry, outside JAX tracing. Keep the file for all VJPs.
    if MODE == 'outcore':
        builder = scf.RHF(mol).density_fit(auxbasis='cc-pvtz-jkfit').with_df
        builder.incore = False
        builder._cderi_to_save = CDERI_PATH
        builder.build()
        assert builder._has_outcore_cderi_placeholder()
        print(f'Out-of-core AO DF: {CDERI_PATH}; '
              f'{os.path.getsize(CDERI_PATH) / 2**30:.3f} GiB', flush=True)
        del builder
    df_inputs, df_pullback = jax.vjp(df_state, mol)
    jax.block_until_ready((df_inputs, df_pullback))
    phase_seconds['df_forward'] = time.perf_counter() - start
print(f"DF forward: {phase_seconds['df_forward']:.6f} s", flush=True)

with scipy_pool.limit(limits=1), ledger.phase('scf_forward'):
    record_threads('scf_forward', 1)
    start = time.perf_counter()
    state, scf_pullback, converged = jax.vjp(scf_state, df_inputs, has_aux=True)
    jax.block_until_ready((state, scf_pullback))
    phase_seconds['scf_forward'] = time.perf_counter() - start
if not converged:
    raise RuntimeError('SCF did not converge')
scf_seconds = phase_seconds['df_forward'] + phase_seconds['scf_forward']
print(f"SCF forward (excluding DF build): {phase_seconds['scf_forward']:.6f} s", flush=True)
print(f'SCF forward (including DF build): {scf_seconds:.6f} s', flush=True)

with scipy_pool.limit(limits=1), ledger.phase('mp2_forward'):
    record_threads('mp2_forward', 1)
    start = time.perf_counter()
    e, mp2_pullback = jax.vjp(mp2_energy, state)
    jax.block_until_ready((e, mp2_pullback))
    phase_seconds['mp2_forward'] = time.perf_counter() - start
print(f"MP2 forward (excluding SCF): {phase_seconds['mp2_forward']:.6f} s", flush=True)

with scipy_pool.limit(limits=1), ledger.phase('mp2_pullback'):
    record_threads('mp2_pullback', 1)
    start = time.perf_counter()
    state_bar, = mp2_pullback(jax.numpy.ones_like(e))
    jax.block_until_ready(state_bar)
    phase_seconds['mp2_pullback'] = time.perf_counter() - start
del mp2_pullback
print(f"MP2 pullback: {phase_seconds['mp2_pullback']:.6f} s", flush=True)

with scipy_pool.limit(limits=1), ledger.phase('scf_pullback'):
    record_threads('scf_pullback', 1)
    start = time.perf_counter()
    # This includes direct molecular and DF cotangents from MP2 as well as orbitals.
    df_inputs_bar, = scf_pullback(state_bar)
    jax.block_until_ready(df_inputs_bar)
    phase_seconds['scf_pullback'] = time.perf_counter() - start
del scf_pullback, state_bar
print(f"SCF pullback (including embedded DF pullbacks): {phase_seconds['scf_pullback']:.6f} s",
      flush=True)

with scipy_pool.limit(limits=DF_THREADS), ledger.phase('df_pullback'):
    record_threads('df_pullback', DF_THREADS)
    start = time.perf_counter()
    # Integral derivatives were evaluated in the SCF/MP2 pullbacks.
    # This attachment pullback reconnects every molecular/auxiliary geometry path.
    jac, = df_pullback(df_inputs_bar)
    jax.block_until_ready(jac)
    phase_seconds['df_pullback'] = time.perf_counter() - start
del df_pullback, df_inputs_bar
print(f"DF attachment pullback: {phase_seconds['df_pullback']:.6f} s", flush=True)
scf_reverse_seconds = phase_seconds['scf_pullback'] + phase_seconds['df_pullback']
print(f'SCF pullback (including DF pullback): {scf_reverse_seconds:.6f} s', flush=True)

grad = jac.coords
print(grad[:10])
total_seconds = time.perf_counter() - t0
print(f'Total energy + gradient wall time: {total_seconds:.6f} s')
print(total_seconds)

# Full results support comparisons beyond the ten gradient rows printed above.
record_threads('after_run', 1)
gradient = jax.device_get(grad).tolist()
assert len(gradient) == 34 and all(len(row) == 3 for row in gradient)
assert math.isfinite(float(e)) and all(math.isfinite(v) for row in gradient for v in row)
reference = json.loads(Path('reference.json').read_text())
energy_delta = abs(float(e) - reference['energy_hartree'])
gradient_delta = max(abs(v - ref) for row, refrow in zip(
    gradient, reference['gradient_hartree_per_bohr'], strict=True)
    for v, ref in zip(row, refrow, strict=True))
input_hash = hashlib.sha256(Path(ATOM).read_bytes()).hexdigest()
validation = {
    'reference_job': reference['job_id'],
    'energy_absolute_difference_hartree': energy_delta,
    'gradient_max_absolute_difference_hartree_per_bohr': gradient_delta,
    'gradient_components_compared': sum(map(len, gradient)),
    'input_matches': input_hash == reference['input_sha256'],
    'energy_tolerance_hartree': 1e-9,
    'gradient_tolerance_hartree_per_bohr': 2e-7,
}
validation['passed'] = (energy_delta < 1e-9 and gradient_delta < 2e-7
                        and validation['input_matches'])
split = ledger.summarize(phase_seconds)
result = {
    'case': CASE, 'mode': MODE, 'job_id': os.environ['SLURM_JOB_ID'],
    'node': socket.gethostname(), 'total_seconds': total_seconds,
    'phase_seconds': phase_seconds, 'energy_hartree': float(e),
    'gradient_hartree_per_bohr': gradient, 'settings': settings,
    'peak_rss_kib': resource.getrusage(resource.RUSAGE_SELF).ru_maxrss,
    'max_memory_mb': MAX_MEMORY, 'cpu_affinity': sorted(os.sched_getaffinity(0)),
    'dense_pools': dense_pools, 'source_sha256': source_hashes,
    'driver_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
    'input_sha256': input_hash,
    'cderi_bytes': os.path.getsize(CDERI_PATH) if MODE == 'outcore' else None,
    'scf_df_split': split, 'timing_events': ledger.events,
    'validation': validation, 'phase_threadpools': phase_threadpools,
    'ledger_sha256': hashlib.sha256(Path(ledger.__file__).read_bytes()).hexdigest(),
}
Path(f"results.{result['job_id']}.{CASE}.json").write_text(json.dumps(result, indent=2) + '\n')
print('SCF/DF split:', json.dumps(split, indent=2), flush=True)
print('Reference validation:', json.dumps(validation), flush=True)
assert validation['passed'], validation
assert split['passed'], split
#INFO: ******************** input file end ********************


